{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "acceptance",
  "type": "object",
  "required": [
    "criteria"
  ],
  "properties": {
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "status"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pending",
              "verified",
              "legacy_unreviewed",
              "evidence_attached",
              "test_executed",
              "observed_pass",
              "human_approved"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
