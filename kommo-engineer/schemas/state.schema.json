{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "state",
  "type": "object",
  "required": [
    "project_id",
    "active_goal_id",
    "last_goal_id",
    "revision",
    "next_action"
  ],
  "properties": {
    "project_id": {
      "type": "string"
    },
    "active_goal_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_goal_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "next_action": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
